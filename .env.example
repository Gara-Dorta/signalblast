# Copy this file to .env and fill in the values, then run `docker compose up`.

###########################
# Required
###########################

# The phone number of the bot
SIGNALBLAST_PHONE_NUMBER=

###########################
# Optional, uncomment to set them
###########################

# The version of signalblast to run, see https://hub.docker.com/r/eradorta/signalblast/tags
# DOCKER_TAG=latest

# The password to become an admin by sending `!add admin <password>` to the bot. It is stored hashed,
# so it only needs to be set on the first start or to change it. Without it nobody can become an admin
# SIGNALBLAST_PASSWORD=

# The contact or group to send health check messages to, the health check is disabled without it
# SIGNALBLAST_HEALTHCHECK_RECEIVER=

# URL for the help message
# SIGNALBLAST_INSTRUCTIONS_URL=

# The disappearing messages timer for the chats in seconds, defaults to 4 weeks,
# 0 leaves the timer of the chats unchanged, -1 disables it
# SIGNALBLAST_EXPIRATION_TIME=2419200

# The address of the signal-cli-rest-api service
# SIGNALBLAST_SIGNAL_SERVICE=localhost:8080

# The port that will be listening for health check requests
# SIGNALBLAST_HEALTHCHECK_PORT=15556

# DEBUG, INFO, WARNING or ERROR. Subscriber ids are only logged at DEBUG
# SIGNALBLAST_LOG_LEVEL=INFO

# Log to this file, rotated weekly, instead of the console. With docker, put it in the data dir
# so that it is kept on the host in ~/.local/share/signalblast
# SIGNALBLAST_LOG_FILE=/home/user/.local/share/signalblast/signalblast.log

# Where the database is stored, defaults to ~/.local/share/signalblast. Only used when running
# without docker, docker always stores it in ~/.local/share/signalblast
# SIGNALBLAST_DATA_DIR=~/.local/share/signalblast

# The version of signal-cli-rest-api to run, see https://hub.docker.com/r/bbernhard/signal-cli-rest-api/tags
# SIGNAL_CLI_REST_API_VERSION=0.101

# The version of signalblast built into the image, only needed when building the image locally,
# docker/compose_build.sh and docker/compose_up.sh set it for you, defaults to 0.0.0
# SIGNALBLAST_VERSION=
