[Unit]
Description=signalblast Signal broadcast bot

[Service]
Type=exec
ExecStart=%h/signalblast/.venv/bin/signalblast
EnvironmentFile=%h/signalblast/systemd/env_file.env
Restart=always

[Install]
WantedBy=default.target


# User unit, it expects the repo to be cloned in ~/signalblast and installed with `uv sync`

# Create the env file from the example and fill in the values
# cp ~/signalblast/systemd/env_file.env.example ~/signalblast/systemd/env_file.env && chmod 600 ~/signalblast/systemd/env_file.env

# Add the service to the user services with
# mkdir -p ~/.config/systemd/user && ln -sn ~/signalblast/systemd/signalblast.service ~/.config/systemd/user/signalblast.service

# The service can be added and enabled with (enabling makes it start on boot)
# systemctl --user daemon-reload && systemctl --user enable signalblast.service

# Without lingering, user services only run while the user is logged in, enable it with
# sudo loginctl enable-linger $USER

# Start the service immediately for testing with
# systemctl --user start signalblast.service

# Visualise the journal by running
# journalctl --user -u signalblast.service
